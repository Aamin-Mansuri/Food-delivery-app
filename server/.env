# ─── FoodRush Server Environment Variables ───────────────────────────────────

# Server port (backend API runs on 5000, Vite client on 5173)
PORT=5000
NODE_ENV=development

# JWT secret key for auth tokens
JWT_SECRET=4a9800e26a5f765257a3f5750af765587c843dbccaeef9412d687cd539178db1

# MongoDB connection URI (uses in-memory store as fallback if unavailable)
MONGO_URI=mongodb://localhost:27017/foodrush

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary (optional - for image uploads; mock is used if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email (optional - logs to console if not configured)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
